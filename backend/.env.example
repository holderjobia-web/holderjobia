# holderjob backend — variáveis de ambiente (EXEMPLO)
# Copie para .env.local (dev local), .env.dev (Railway dev) ou .env (Railway prod).
# NUNCA commitar arquivos .env com valores reais.

# Ambiente: producao | dev | local
AMBIENTE=local

# Supabase (usar o banco DEV ou PROD conforme o ambiente)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# JWT — segredos separados para portal e admin (gerar strings longas e aleatórias)
JWT_SECRET=
JWT_ADMIN_SECRET=
JWT_EXPIRATION_HOURS=8

# OpenAI — agente de IA (fase futura; opcional por enquanto)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Servidor
# CORS_ORIGINS aceita JSON ou lista separada por vírgula
CORS_ORIGINS=http://localhost:3000
PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
